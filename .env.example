# Start in demo mode; do not mix demo and real data in the same vedrfolnir-data volume.
SOURCE_MODE=demo
ETA_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
ETA_POLL_SECONDS=120
ETA_PREDICTION_INTERVAL_SECONDS=300
# Recompute historical runner-pool concurrency every 10 minutes; live counts refresh each poll.
ETA_POOL_CAPACITY_REFRESH_SECONDS=600
ETA_IMPORT_BATCH=2000
ETA_IMPORT_LIMIT_PER_POLL=10000
ETA_MIN_ML_TRAINING=30
ETA_MAX_HISTORY_PER_GROUP=500
# Completed job observations and departed unresolved forecasts are pruned after this many days.
ETA_JOB_RETENTION_DAYS=90
# Replay a bounded, rolling window for history inserted after its completion cursor passed.
# 0 disables reconciliation; records older than this window are not recovered automatically.
ETA_HISTORY_RECONCILE_DAYS=7
ETA_HISTORY_RECONCILE_LIMIT_PER_POLL=2000
# Aged history and plan forecast cleanup, in bounded batches per successful poll.
# Referenced training samples, active plans/jobs and still-labelable observations are protected.
ETA_HISTORY_RETENTION_DAYS=365
ETA_PLAN_RETENTION_DAYS=365
ETA_PLAN_UNRESOLVED_RETENTION_DAYS=730
ETA_RETENTION_BATCH=1000
# Optional Compose host source directory overrides; see docs/quickstart.md.
# CSV_SOURCE_PATH=./examples/quickstart/csv
# SQL_QUERY_PATH=./examples/quickstart/sqlserver/queries
# Use SOURCE_MODE=files to read three CSVs from examples/data.
# Use SOURCE_MODE=mssql for production SQL Server (rebuild image with INSTALL_MSSQL=true).
INSTALL_MSSQL=false
# Only used when SOURCE_MODE=mssql (read-only SQL Server login)
MSSQL_HOST=your-internal-sqlserver
MSSQL_PORT=1433
MSSQL_DATABASE=your_database
MSSQL_USER=eta_readonly
MSSQL_PASSWORD=CHANGE_ME

# Default: JSON lines to stdout. Set LOG_FORMAT=text for plain console logs.
LOG_LEVEL=INFO
LOG_FORMAT=json
# Optional: trusted logging.config.dictConfig JSON, mounted from ./logging/
# This overrides LOG_LEVEL / LOG_FORMAT and defines all destinations.
LOG_CONFIG_FILE=
# Example: LOG_CONFIG_FILE=/srv/logging/file-and-console.json
