{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["pep621", "pip_requirements", "github-actions", "dockerfile"],
  "timezone": "Europe/Belgrade",
  "schedule": ["* 2-6 * * 1"],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "prConcurrentLimit": 3,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Allow only patch-level development-tool updates to automerge after independent policy validation and required CI",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.optional-dependencies"],
      "matchJsonata": ["managerData.depGroup = 'dev'"],
      "matchPackageNames": ["pytest", "ruff", "build", "twine", "httpx"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Runtime libraries must be reviewed for model, SQLite, and API compatibility",
      "matchPackageNames": ["river", "SQLAlchemy", "fastapi", "uvicorn", "pymssql"],
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "Weekly GitHub Actions",
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "Container bases",
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
